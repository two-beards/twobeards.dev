<style>
	.crest {
		overflow: visible;
	}

	.crest__tongue {
		transform-box: fill-box;
		transform-origin: top center;
		scale: 1 0;
		transition: scale 250ms cubic-bezier(0.34, 1.8, 0.64, 1);
	}

	/* Any ancestor with data-crest-hover controls the reveal */
	:global([data-crest-hover]:hover) .crest__tongue,
	:global([data-crest-hover]:focus-visible) .crest__tongue {
		scale: 1 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.crest__tongue {
			transition: none;
		}
	}
</style>
