---
// The two mustard corner tabs from the comps: crest logo (top-left)
// and the "menu?" tab (top-right) that opens the who/what/when/where/why flyout.
---

<header class="site-tabs">
	<a class="tab tab--logo" href="/">
		<img src="/logo-crest.svg" width="33" height="46" alt="Two Beards — home" />
	</a>

	<nav class="tab tab--menu" aria-label="Main" data-menu>
		<button
			type="button"
			class="menu-button"
			aria-expanded="false"
			aria-controls="menu-flyout"
		>
			menu<span class="menu-button__q" aria-hidden="true">?</span>
		</button>
		<ul class="menu-flyout" id="menu-flyout" hidden>
			<li><a href="/#who">who</a></li>
			<li><a href="/#work">what</a></li>
			<!-- TODO: real destinations for when/where/why once those exist -->
			<li><a href="/#services">when</a></li>
			<li><a href="/#contact">where</a></li>
			<li><a href="/#who">why</a></li>
		</ul>
	</nav>
</header>

<style>
	.site-tabs {
		position: absolute;
		inset: 0 0 auto 0;
		z-index: 10;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		pointer-events: none;
	}

	.tab {
		pointer-events: auto;
		display: grid;
		place-items: center;
		width: var(--tab-size);
		height: var(--tab-size);
		background: var(--mustard);
		color: var(--ink);
	}

	.tab--logo {
		margin-left: 0;
		box-shadow: var(--frame) var(--frame) 0 0 var(--white);
	}

	.tab--menu {
		position: relative;
		width: auto;
		min-width: var(--tab-size);
		margin-right: var(--frame);
		box-shadow:
			calc(-1 * var(--frame)) var(--frame) 0 0 var(--white),
			var(--frame) 0 0 0 var(--white);
	}

	.menu-button {
		width: 100%;
		height: 100%;
		padding-inline: var(--space-s);
		border: 0;
		background: none;
		cursor: pointer;
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.125rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		line-height: var(--tab-size);
		white-space: nowrap;
	}

	.menu-button__q {
		display: inline-block;
		transition: rotate 200ms ease;
	}

	[aria-expanded="true"] .menu-button__q {
		rotate: 180deg;
	}

	.menu-flyout {
		position: absolute;
		top: 100%;
		right: 0;
		min-width: 11rem;
		margin: 0;
		padding: var(--space-m) var(--space-l);
		list-style: none;
		background: var(--mustard);
		box-shadow: calc(-1 * var(--frame)) var(--frame) 0 0 var(--white);
	}

	.menu-flyout a {
		display: block;
		padding-block: var(--space-xs);
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 1.25rem;
		color: var(--teal);
		text-decoration: none;
	}

	.menu-flyout a:hover {
		color: var(--ink);
		text-decoration: underline;
	}

	@media (max-width: 40rem) {
		.tab--menu {
			margin-right: 0;
			box-shadow: calc(-1 * var(--frame)) var(--frame) 0 0 var(--white);
		}
	}
</style>

<script>
	const nav = document.querySelector("[data-menu]");
	const button = nav?.querySelector("button");
	const flyout = nav?.querySelector("ul");

	if (nav && button && flyout) {
		const setOpen = (open: boolean) => {
			button.setAttribute("aria-expanded", String(open));
			flyout.hidden = !open;
		};

		button.addEventListener("click", () => {
			setOpen(button.getAttribute("aria-expanded") !== "true");
		});

		document.addEventListener("click", (event) => {
			if (!nav.contains(event.target as Node)) setOpen(false);
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") {
				setOpen(false);
				button.focus();
			}
		});

		// Close after picking an anchor on the same page
		flyout.addEventListener("click", (event) => {
			if ((event.target as HTMLElement).closest("a")) setOpen(false);
		});
	}
</script>
